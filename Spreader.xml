    <workAreas>
        <workArea type="sprayer" functionName="processSprayerArea" disableBackwards="false" requiresGroundContact="false" requiresOwnedFarmland="false" sprayType="1">
            <area startNode="workAreaStart" widthNode="workAreaWidth" heightNode="workAreaHeight" />
        </workArea>
		<workArea type="sprayer" functionName="processSprayerArea" disableBackwards="false" requiresGroundContact="false" sprayType="2">
            <area startNode="workAreaStart" widthNode="workAreaWidth" heightNode="workAreaHeight" />
        </workArea>
        <workArea type="saltSpreader" functionName="processSaltSpreaderArea" disableBackwards="false" requiresGroundContact="false" requiresOwnedFarmland="false" sprayType="3">
