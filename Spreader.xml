    <saltSpreader fillUnitIndex="1" usage="0.1" usageWorkArea="3"> 
        <animationNodes>
            <animationNode node="Spreader"   rotSpeed="-1000" rotAxis="2"  turnOnFadeTime="1" turnOffFadeTime="10" /> 
        </animationNodes>
        <effects>
            <effectNode effectClass="FertilizerMotionPathEffect" effectType="FERTILIZER" linkNode="sprayEffect">
                <motionPathEffect textureFilename="$data/vehicles/bredal/sg/fertilizerEffectLeftArray.dds" numRows="10" rowLength="24" minFade="0.03" isLeft="true" />
            </effectNode>
            <effectNode effectClass="FertilizerMotionPathEffect" effectType="FERTILIZER" linkNode="sprayEffect2">
