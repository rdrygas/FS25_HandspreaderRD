    <sprayer fillUnitIndex="1" unloadInfoIndex="1">
        <usageScales workAreaIndex="1" scale="0.1" />
        
        <animationNodes>
            <animationNode node="Spreader"   rotSpeed="-1000" rotAxis="2"  turnOnFadeTime="1" turnOffFadeTime="10" /> <!--rotating plate which spreads the salt-->
        </animationNodes>

        <effects>
            <effectNode effectNode="smokeEmitter" delay="0.1" materialType="unloading" fadeTime="0.5" materialTypeId="1" />    
        </effects>  

        <sprayTypes>
            <sprayType fillTypes="fertilizer unknown">
                <usageScales workAreaIndex="1" scale="1" />

                <effects>
                    <effectNode effectClass="FertilizerMotionPathEffect" effectType="FERTILIZER" linkNode="fertilizerSprayEffect">
                        <motionPathEffect textureFilename="$data/vehicles/amazone/zgts10001/fertilizerEffectLeftArray.dds" numRows="22" rowLength="32" minFade="0.03" isLeft="true"/> 
                    </effectNode>
                    <effectNode effectClass="FertilizerMotionPathEffect" effectType="FERTILIZER" linkNode="fertilizerSprayEffect2">
                        <motionPathEffect textureFilename="$data/vehicles/amazone/zgts10001/fertilizerEffectRightArray.dds" numRows="22" rowLength="32" minFade="0.03" isLeft="false"/> 
                    </effectNode>
                </effects>

                
				
				<turnedAnimation name="comporta" turnOnSpeedScale="1" turnOffSpeedScale="-1" />
            </sprayType>



            <sprayType fillTypes="lime">
                 <usageScales workAreaIndex="2" scale="1" />

                <effects>
                    <effectNode effectClass="FertilizerMotionPathEffect" effectType="FERTILIZER" linkNode="sprayEffect">
                        <motionPathEffect textureFilename="$data/vehicles/bredal/limeEffectLeftSmallArray.dds" numRows="12" rowLength="32" minFade="0.03" isLeft="true"/>   <!--numRows normalerweise 12-->
                    </effectNode>
                    <effectNode effectClass="FertilizerMotionPathEffect" effectType="FERTILIZER" linkNode="sprayEffect2">
                        <motionPathEffect textureFilename="$data/vehicles/bredal/limeEffectRightSmallArray.dds" numRows="12" rowLength="32" minFade="0.03" isLeft="false"/>   <!--numRows normalerweise 12-->
                    </effectNode>
                    <effectNode effectNode="smokeEmitter" delay="0.5" effectClass="ParticleEffect" particleType="smoke" materialType="smokeParticle" emitCountScale="0.3" worldSpace="true"/>  <!--emitCountScale normalerweise 5-->
                </effects>

                <!--<ai>
                    <areaMarkers leftNode="workAreaStart" rightNode="workAreaWidth" backNode="workAreaHeight" />
                    <sizeMarkers leftNode="workAreaStart" rightNode="workAreaWidth" backNode="workAreaHeight" />
                    <collisionTrigger node="aiCollisionTrigger" width="3.0" height="3.1"/>
                </ai>-->
				<turnedAnimation name="comporta" turnOnSpeedScale="1" turnOffSpeedScale="-1" />
            </sprayType>

